{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-ara",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "741a400b-902f-4000-94c3-c6e671585408","database_name": "web-app-ara" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "79673c7cf33544ecab29a1f9c22576ad" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
